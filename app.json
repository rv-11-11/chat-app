{
  "expo": {
    "name": "LinkiPlay - Telegram Style Messenger",
    "slug": "linkiplay",
    "description": "LinkiPlay connects your communities, channels, and groups with rich messaging.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "linkiplay",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#ffffff",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.linkiplay.messenger",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "POST_NOTIFICATIONS",
        "RECORD_AUDIO",
        "CAMERA"
      ],
      "enableProguardInReleaseBuilds": true,
      "adaptiveIcon": {
        "backgroundColor": "#3b82f6",
        "foregroundImage": "./assets/images/logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png",
      "name": "LinkiPlay",
      "shortName": "LinkiPlay",
      "description": "LinkiPlay connects your communities, channels, and groups with rich messaging.",
      "startUrl": "/",
      "scope": "/",
      "display": "standalone",
      "backgroundColor": "#ffffff",
      "themeColor": "#3b82f6",
      "orientation": "portrait-primary"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "https://chat-app-qwrr.onrender.com",
      "socketUrl": "https://chat-app-qwrr.onrender.com",
  "privacyPolicyUrl": "https://yourdomain.com/privacy",
      "googleWebClientId": "170631155124-jt38kvf290u2pa6dht834bmblv527tsq.apps.googleusercontent.com",
      "googleIosClientId": "YOUR_IOS_CLIENT_ID.apps.googleusercontent.com",
      "googleAndroidClientId": "170631155124-38er02pg8ve6ar9ts6h2u0udhk3hgek3.apps.googleusercontent.com"
    }
  }
}
